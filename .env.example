# --- Bot (game panel / VPS) ---
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register commands to one guild while testing
GUILD_ID=

MONGODB_URI=
MONGODB_DB=degeneratebot

# Optional bot tuning
# VOICE_FLUSH_MS=60000
# SKIP_STATS_CHART=1
# DB_LOG=0

# --- Dashboard (Vercel + local web/) ---
# Same Discord application as the bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token lets the dashboard verify the bot is in a guild
DISCORD_TOKEN=

MONGODB_URI=
MONGODB_DB=degeneratebot

# 32+ character random string (openssl rand -base64 32)
SESSION_SECRET=

# Comma-separated Discord user IDs allowed to access /admin (platform operator)
PLATFORM_ADMIN_USER_IDS=

# Production site URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=
